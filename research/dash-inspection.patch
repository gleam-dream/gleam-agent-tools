 esac
diff --git a/tools/scripts/inspection-queries.sh b/tools/scripts/inspection-queries.sh
new file mode 100644
index 0000000..0c9ed79
--- /dev/null
+++ b/tools/scripts/inspection-queries.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# This projection owns a private PostgreSQL server solely for Squirrel metadata.
+# It never reads DATABASE_URL or touches an application/deployment database.
+set -euo pipefail
+repo_root=$(cd "$(dirname "$0")/../.." && pwd)
+mode=${1:-check}
+case "$mode" in check|generate) ;; *) echo 'Usage: inspection-queries.sh [check|generate]' >&2; exit 2 ;; esac
+(cd "$repo_root/packages/abertura_service" && gleam build --warnings-as-errors)
+scratch=$(mktemp -d /tmp/dash-inspection-queries.XXXXXX)
+started=0
+cleanup() {
+  local status=$?
+  trap - EXIT
+  if [[ "$started" == 1 ]]; then pg_ctl -D "$scratch/data" -m fast -w stop >/dev/null || status=1; fi
+  rm -rf "$scratch"
+  exit "$status"
+}
+trap cleanup EXIT
+port=$(python3 - <<'PY'
+import socket
+with socket.socket() as listener:
+    listener.bind(("127.0.0.1", 0))
+    print(listener.getsockname()[1])
+PY
+)
+initdb -D "$scratch/data" --username=inspection_test --auth-local=trust --auth-host=trust >/dev/null
+pg_ctl -D "$scratch/data" -o "-h 127.0.0.1 -p $port -k $scratch" -l "$scratch/postgres.log" -w start >/dev/null
+started=1
+export DATABASE_URL="postgresql://inspection_test@127.0.0.1:$port/postgres"
+# This permanent table exists only in the generator's disposable database.
+# Runtime creates a transaction-local table of the same shape instead.
+psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -qc 'CREATE TABLE dash_inspection_probe(key text PRIMARY KEY, value text NOT NULL)'
+mkdir -p "$scratch/project/src/dash_abertura_backend/inspection"
+printf 'name = "inspection_queries"\nversion = "0.1.0"\n' > "$scratch/project/gleam.toml"
+cp -R "$repo_root/backend/api/src/dash_abertura_backend/inspection/sql" "$scratch/project/src/dash_abertura_backend/inspection/"
+cp "$repo_root/backend/api/src/dash_abertura_backend/inspection/sql.gleam" "$scratch/project/src/dash_abertura_backend/inspection/"
+args=()
+if [[ "$mode" == check ]]; then args=(check); fi
+(cd "$scratch/project" && erl -noshell -pa "$repo_root"/packages/abertura_service/build/dev/erlang/*/ebin \
+  -eval 'abertura_service@@main:run(squirrel).' -extra "${args[@]}")
+if [[ "$mode" == generate ]]; then
+  cp "$scratch/project/src/dash_abertura_backend/inspection/sql.gleam" "$repo_root/backend/api/src/dash_abertura_backend/inspection/sql.gleam"
+fi
