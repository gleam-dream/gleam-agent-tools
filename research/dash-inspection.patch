+++ b/backend/api/test/inspection_test.gleam
@@ -0,0 +1,24 @@
+import dash_abertura_backend/inspection
+import gleam/list
+import gleeunit/should
+
+pub fn inspection_is_bounded_and_contains_metadata_test() -> Nil {
+  let overview = inspection.overview()
+  { overview.processes > 0 } |> should.be_true
+  { overview.memory_bytes > 0 } |> should.be_true
+  inspection.processes(500) |> list.length |> should.equal(10)
+  inspection.processes(1) |> list.length |> should.equal(1)
+  inspection.children("kernel_sup") |> should.be_ok
+  inspection.children("inspection_missing_supervisor") |> should.be_error
+  inspection.trace(0, 1) |> should.equal(Error(inspection.InvalidBounds))
+  inspection.trace(10, 21) |> should.equal(Error(inspection.InvalidBounds))
+}
+
+pub fn recon_trace_is_bounded_and_cleans_up_test() -> Nil {
+  let assert Ok(trace) = inspection.trace(50, 2)
+  { trace.events > 0 } |> should.be_true
+  { trace.events <= 2 } |> should.be_true
+  trace.cleaned |> should.be_true
+  let _ = inspection.resources() |> should.be_ok
+  Nil
+}
