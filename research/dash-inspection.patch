@@ -0,0 +1,276 @@
+//// This module contains the code to run the sql queries defined in
+//// `./src/dash_abertura_backend/inspection/sql`.
+//// > 🐿️ This module was generated automatically using v4.7.0 of
+//// > the [squirrel package](https://github.com/giacomocavalieri/squirrel).
+////
+
+import gleam/dynamic/decode
+import pog
+
+/// Runs the `create_probe` query
+/// defined in `./src/dash_abertura_backend/inspection/sql/create_probe.sql`.
+///
+/// > 🐿️ This function was generated automatically using v4.7.0 of
+/// > the [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub fn create_probe(
+  db: pog.Connection,
+) -> Result(pog.Returned(Nil), pog.QueryError) {
+  let decoder = decode.map(decode.dynamic, fn(_) { Nil })
+
+  "CREATE TEMP TABLE dash_inspection_probe (key text PRIMARY KEY, value text NOT NULL) ON
+COMMIT
+DROP;
+"
+  |> pog.query
+  |> pog.returning(decoder)
+  |> pog.execute(db)
+}
+
+/// A row you get from running the `insert_probe` query
+/// defined in `./src/dash_abertura_backend/inspection/sql/insert_probe.sql`.
+///
+/// > 🐿️ This type definition was generated automatically using v4.7.0 of the
+/// > [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub type InsertProbeRow {
+  InsertProbeRow(key: String, value: String)
+}
+
+/// Runs the `insert_probe` query
+/// defined in `./src/dash_abertura_backend/inspection/sql/insert_probe.sql`.
+///
+/// > 🐿️ This function was generated automatically using v4.7.0 of
+/// > the [squirrel package](https://github.com/giacomocavalieri/squirrel).
+///
+pub fn insert_probe(
+  db: pog.Connection,
+  arg_1: String,
+) -> Result(pog.Returned(InsertProbeRow), pog.QueryError) {
+  let decoder = {
+    use key <- decode.field(0, decode.string)
+    use value <- decode.field(1, decode.string)
+    decode.success(InsertProbeRow(key:, value:))
+  }
+
+  "INSERT INTO
+  dash_inspection_probe (key, value)
+VALUES
+  ($1, 'before')
+RETURNING
+  key::text AS key,
+  value::text AS value;
+"
+  |> pog.query
+  |> pog.parameter(pog.text(arg_1))
+  |> pog.returning(decoder)
+  |> pog.execute(db)
+}
+
