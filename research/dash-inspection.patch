@@ -0,0 +1,36 @@
+//// Runs only against an explicitly supplied disposable database. Never shipped.
+
+import dash_abertura_backend/inspection
+import envoy
+import gleam/erlang/process
+import gleam/io
+import pog
+
+pub fn main() -> Nil {
+  start_pool()
+  let assert Ok(observation) = inspection.database()
+  let assert True = observation.read_only
+  let assert Ok(inspection.RollbackProof(1, 1, True)) =
+    inspection.rollback_probe()
+  // A new query through that same single-connection pool remains usable.
+  let assert Ok(after) = inspection.database()
+  let assert True = after.read_only
+  let assert True = after.backend_pid == observation.backend_pid
+  io.println(
+    "{\"inspection_database\":\"read_only\",\"disposable_repair\":\"rolled_back\",\"same_connection_reused\":true}",
+  )
+}
+
+fn start_pool() -> Nil {
+  let assert Ok(url) = envoy.get("DASH_INSPECTION_TEST_DATABASE_URL")
+  let assert Ok(config) =
+    pog.url_config(process.new_name("dash_auth_pool"), url)
+  let assert Ok(_) = pog.start(config |> pog.pool_size(1))
+  Nil
+}
+
+/// Private acceptance fixture; excluded from production shipment.
+pub fn serve() -> Nil {
+  start_pool()
+  process.sleep_forever()
+}
