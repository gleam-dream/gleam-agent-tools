diff --git a/tools/scripts/check-inspection-image.py b/tools/scripts/check-inspection-image.py
new file mode 100644
index 0000000..849edd0
--- /dev/null
+++ b/tools/scripts/check-inspection-image.py
@@ -0,0 +1,209 @@
+"""Validate a prebuilt Dash image using disposable PostgreSQL and fixture data."""
+
+import argparse
+import json
+import os
+import secrets
+import subprocess
+import tempfile
+import time
+import uuid
+import re
+from pathlib import Path
+
+suffix = str(os.getpid())
+network = "beam-inspection-" + suffix
+pg = "beam-pg-" + suffix
+service = "beam-dash-" + suffix
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("image")
+image = parser.parse_args().image
+
+
+def run(args, ok=True):
+    p = subprocess.run(
+        args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60
+    )
+    if ok and p.returncode:
+        raise RuntimeError(
+            "operation failed: "
+            + args[0]
+            + " "
+            + args[1]
+            + " (private details suppressed)"
+        )
+    return p
+
+
+fixture_fd, fixture_name = tempfile.mkstemp(prefix="beam-fixture-", dir="/tmp")
+os.close(fixture_fd)
+fixture = Path(fixture_name)
+fixture.write_text(
+    "\n".join(
+        [
+            "DATABASE_URL=postgresql://postgres@" + pg + ":5432/postgres",
+            "DASH_DATABASE_INSTANCE=" + str(uuid.uuid4()),
+            "DASH_PUBLIC_ORIGIN=https://inspection.example.invalid",
+            "OIDC_ISSUER=https://identity.example.invalid",
+            "OIDC_CLIENT_ID=inspection-fixture",
+            "OIDC_CLIENT_SECRET=inspection-fixture-only",
+            "WISP_SECRET_KEY=inspection-fixture-key-for-disposable-tests-only-at-least-sixty-four-bytes",
+            "WARDEN_SEALING_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
+            "BEAM_REQUIRE_COOKIE=1",
+            "BEAM_COOKIE=" + secrets.token_hex(32),
+            "BIND_ADDRESS=0.0.0.0",
+            "DASH_OPERATIONS_DB=/tmp/inspection-operations.sqlite",
+        ]
+    )
+    + "\n"
+)
+fixture.chmod(0o600)
+try:
+    run(["docker", "network", "create", network])
+    run(
+        [
+            "docker",
+            "run",
+            "-d",
+            "--name",
+            pg,
+            "--network",
+            network,
+            "-e",
+            "POSTGRES_HOST_AUTH_METHOD=trust",
+            "postgres:16.15",
+        ]
+    )
+    for _ in range(60):
+        if (
+            run(
+                ["docker", "exec", pg, "pg_isready", "-U", "postgres"], False
+            ).returncode
+            == 0
+        ):
+            break
+        time.sleep(0.2)
+
+    def one(*args):
+        return run(
+            [
+                "docker",
+                "run",
+                "--rm",
+                "--network",
+                network,
+                "--env-file",
+                str(fixture),
+                image,
+                *args,
+            ]
+        )
+
+    print("image_recovery_enroll=" + one("database", "enroll").stdout.strip())
+    one("membership-migrate")
+    print("image_explicit_membership_migration=passed")
+    run(
+        [
+            "docker",
+            "run",
+            "-d",
+            "--name",
+            service,
+            "--network",
+            network,
+            "--env-file",
+            str(fixture),
+            image,
+        ]
+    )
+    beam = ["docker", "exec", "--user", "app", service, "/app/tools/beam/beam-tool"]
+
+    def rpc(f, args="[]", mod="dash_abertura_backend@inspection", ok=True):
+        return run([*beam, "rpc", "dash@127.0.0.1", mod, f, args], ok)
+
+    for _ in range(60):
+        if rpc("database", ok=False).returncode == 0:
+            break
+        time.sleep(0.25)
+    else:
+        raise RuntimeError("Packaged Dash database inspection did not become ready")
+    rpc("children", '[<<"kernel_sup">>]')
+    print("image_supervision=passed")
+    # Host-side PTY test; the image uses only its precompiled runtime client.
+    run(
+        [
+            "python3",
+            "tools/beam/check-consoles.py",
+            "--client",
+            "/app/tools/beam/beam-tool",
+            "--node",
+            "dash@127.0.0.1",
+            "--iex",
+            "--prefix",
+            json.dumps(["docker", "exec", "-it", "--user", "app", service]),
+        ]
+    )
+    print("image_erlang_iex_console_and_disconnect_survival=passed")
+    run(
+        [
+            "docker",
+            "exec",
+            "--user",
+            "app",
+            service,
+            "sh",
+            "-c",
+            'test "$(id -un)" = app && test "$HOME" = /home/app && test "$(stat -c %a /home/app/.erlang.cookie)" = 600 && test "$(stat -c %u /home/app/.erlang.cookie)" = "$(id -u)"',
+        ]
+    )
+    print("image_cookie_owner_mode=passed")
+    epmd = run(["docker", "exec", service, "epmd", "-names"]).stdout
+    distribution = re.search(r"name dash at port (\d+)", epmd)
+    if not distribution:
+        raise RuntimeError("Expected service EPMD registration")
+    listeners = run(["docker", "exec", service, "netstat", "-lnt"]).stdout
+    for port in ["4369", distribution.group(1)]:
+        addresses = [
+            line.split()[3]
+            for line in listeners.splitlines()
+            if len(line.split()) > 3 and line.split()[3].endswith(":" + port)
+        ]
+        if not addresses or any(
+            address.rsplit(":", 1)[0] not in ["127.0.0.1", "::1"]
+            for address in addresses
+        ):
+            raise RuntimeError("Distribution listener is missing or not loopback-only")
+    print("image_distribution_loopback=passed")
+    for f, args in [
+        ("overview", "[]"),
+        ("processes", "[2]"),
+        ("ets", "[]"),
+        ("resources", "[]"),
+        ("trace", "[100,5]"),
+        ("database", "[]"),
+        ("rollback_probe", "[]"),
+    ]:
+        result = rpc(f, args)
+        print("image_" + f + "=" + result.stdout.strip())
+    for mod in ["Elixir.IEx", "elixir", "recon"]:
+        result = rpc("ensure_loaded", "['" + mod + "']", "code")
+        print("image_target_module=" + result.stdout.strip())
+    safe = run(
+        [
+            "docker",
+            "exec",
+            service,
+            "sh",
+            "-c",
+            "! command -v gleam && test ! -d /app/.git && test ! -d /app/backend/api/src && test ! -f /app/tools/beam/beam_tool.erl",
+        ]
+    )
+    print("image_no_gleam_compiler_or_checkout=passed")
+    result = rpc("overview")
+    print("image_after_rpc_disconnect=passed")
+    print("image_inspection_acceptance=passed", flush=True)
+finally:
+    fixture.unlink(missing_ok=True)
+    for name in [service, pg]:
+        run(["docker", "rm", "-f", name], False)
+    run(["docker", "network", "rm", network], False)
