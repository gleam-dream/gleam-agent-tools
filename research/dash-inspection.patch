new file mode 100644
index 0000000..0a8f515
--- /dev/null
+++ b/tools/scripts/check-inspection.sh
@@ -0,0 +1,103 @@
+#!/usr/bin/env bash
+# Run inside nix develop. Owns disposable PostgreSQL and an isolated named VM.
+set -euo pipefail
+repo_root=$(cd "$(dirname "$0")/../.." && pwd)
+bash "$repo_root/tools/scripts/inspection-queries.sh" check
+bash "$repo_root/tools/scripts/build-backend.sh" dev
+scratch=$(mktemp -d /tmp/dash-inspection-check.XXXXXX)
+started=0
+service_pid=
+cleanup() {
+  local status=$?
+  trap - EXIT
+  if [[ -n "$service_pid" ]]; then kill "$service_pid" 2>/dev/null || true; wait "$service_pid" 2>/dev/null || true; fi
+  if [[ "$started" == 1 ]]; then pg_ctl -D "$scratch/data" -m fast -w stop >/dev/null || status=1; fi
+  rm -rf "$scratch"
+  exit "$status"
+}
+trap cleanup EXIT
+port=$(python3 - <<'PY'
+import socket
+with socket.socket() as listener:
+    listener.bind(("127.0.0.1", 0))
+    print(listener.getsockname()[1])
+PY
+)
+initdb -D "$scratch/data" --username=inspection_test --auth-local=trust --auth-host=trust >/dev/null
+pg_ctl -D "$scratch/data" -o "-h 127.0.0.1 -p $port -k $scratch" -l "$scratch/postgres.log" -w start >/dev/null
+started=1
+export DASH_INSPECTION_TEST_DATABASE_URL="postgresql://inspection_test@127.0.0.1:$port/postgres"
+cd "$repo_root/backend/api"
+gleam run -m dash_abertura_backend/inspection_check
+# Actual consumer startup gets a newly enrolled disposable database and explicit
+# owner migration, using test-only identity configuration without provider calls.
+export DATABASE_URL="$DASH_INSPECTION_TEST_DATABASE_URL"
+export DASH_DATABASE_INSTANCE="$(python3 -c 'import uuid; print(uuid.uuid4())')"
+export PORT="$(python3 - <<'PORT'
+import socket
+with socket.socket() as listener:
+    listener.bind(("127.0.0.1", 0))
+    print(listener.getsockname()[1])
+PORT
+)"
+export DASH_PUBLIC_ORIGIN=https://inspection.example.invalid
+export OIDC_ISSUER=https://identity.example.invalid
+export OIDC_CLIENT_ID=inspection-fixture
+export OIDC_CLIENT_SECRET=inspection-fixture-only
+export WISP_SECRET_KEY=inspection-fixture-key-for-disposable-tests-only-at-least-sixty-four-bytes
+export WARDEN_SEALING_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
+export DASH_OPERATIONS_DB="$scratch/operations.sqlite"
+export BIND_ADDRESS=127.0.0.1
+unset GEMINI_API_KEY OIDC_TRUST_ANCHORS_FILE
+bash "$repo_root/tools/scripts/manage-database.sh" enroll
+erl -noshell -kernel logger_level none -pa build/dev/erlang/*/ebin \
+  -eval 'application:ensure_all_started(dash_abertura_backend), dash_abertura_backend@membership@migrate:main(), halt().'
+elixir_lib=$(dirname "$(elixir -e 'IO.puts(:code.lib_dir(:elixir))')")
+node="dash_inspection_check_$$@127.0.0.1"
+beam="$repo_root/tools/beam/beam-tool"
+erlc -o "$repo_root/tools/beam/ebin" "$repo_root/tools/beam/beam_tool.erl"
+"$beam" run "$node" -noshell -pa "$elixir_lib"/*/ebin build/dev/erlang/*/ebin \
+  -eval 'application:ensure_all_started(elixir), application:ensure_all_started(dash_abertura_backend), dash_abertura_backend:main().' \
+  >"$scratch/service.log" 2>&1 &
+service_pid=$!
+ready=0
+for _ in {1..50}; do
+  if "$beam" rpc "$node" dash_abertura_backend@inspection database '[]' 2000 >"$scratch/ready" 2>/dev/null; then ready=1; break; fi
+  sleep 0.1
+done
+[[ "$ready" == 1 ]] || { echo 'Isolated inspection VM failed to start' >&2; exit 1; }
+python3 "$repo_root/tools/beam/check-consoles.py" --client "$beam" --node "$node" --iex
+module=dash_abertura_backend@inspection
+"$beam" rpc "$node" "$module" overview '[]'
+"$beam" rpc "$node" "$module" processes '[2]'
+"$beam" rpc "$node" "$module" resources '[]'
+"$beam" rpc "$node" "$module" database '[]'
+"$beam" rpc "$node" "$module" rollback_probe '[]'
+"$beam" rpc "$node" "$module" trace '[50,2]'
+# Deliberately disconnect a client while target-owned trace cleanup is pending.
+"$beam" rpc "$node" "$module" trace '[2000,5]' >"$scratch/trace" 2>&1 &
+client_pid=$!
+observed=0
+for _ in {1..10}; do
+  if "$beam" rpc "$node" erlang whereis '[dash_inspection_trace_owner]' 2000 2>/dev/null | rg '^<' >/dev/null \
+    && "$beam" rpc "$node" erlang whereis '[recon_trace_tracer]' 2000 2>/dev/null | rg '^<' >/dev/null; then
+    observed=1; break
+  fi
+  sleep 0.05
+done
+[[ "$observed" == 1 ]] || { echo 'Target trace was not observed before client disconnect' >&2; exit 1; }
+kill "$client_pid" 2>/dev/null || true
+wait "$client_pid" 2>/dev/null || true
+sleep 2
+"$beam" rpc "$node" erlang whereis '[dash_inspection_trace_owner]' | rg '^undefined$' >/dev/null
+"$beam" rpc "$node" erlang whereis '[recon_trace_tracer]' | rg '^undefined$' >/dev/null
+"$beam" rpc "$node" "$module" database '[]'
+"$beam" rpc "$node" "$module" overview '[]'
+kill "$service_pid"
+wait "$service_pid" 2>/dev/null || true
+service_pid=
+if "$beam" rpc "$node" "$module" overview '[]' >"$scratch/stopped" 2>&1; then
+  echo 'Stopped-node RPC unexpectedly succeeded' >&2; exit 1
+fi
+rg 'node_unreachable' "$scratch/stopped" >/dev/null
+printf '%s\n' '{"inspection_acceptance":"passed","database":"disposable","target":"actual_dash_main_on_disposable_database"}'
