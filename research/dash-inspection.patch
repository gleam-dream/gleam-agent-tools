diff --git a/backend/api/src/dash_abertura_backend/inspection.gleam b/backend/api/src/dash_abertura_backend/inspection.gleam
new file mode 100644
index 0000000..5fafacf
--- /dev/null
+++ b/backend/api/src/dash_abertura_backend/inspection.gleam
@@ -0,0 +1,231 @@
+//// Operator-only RPC surface. Outputs exclude process state, messages, SQL
+//// values, credentials and customer rows. This is not an HTTP endpoint.
+
+import dash_abertura_backend/inspection/sql
+import exception
+import gleam/erlang/process
+import gleam/list
+import gleam/result
+import gleam/string
+import pog
+
+pub type Process {
+  Process(
+    pid: String,
+    name: String,
+    memory: Int,
+    mailbox: Int,
+    status: String,
+    reductions: Int,
+    stack: List(String),
+  )
+}
+
+pub type Table {
+  Table(
+    name: String,
+    size: Int,
+    memory_words: Int,
+    owner: String,
+    protection: String,
+    kind: String,
+  )
+}
+
+pub type Overview {
+  Overview(node: String, processes: Int, memory_bytes: Int, schedulers: Int)
+}
+
+pub type Database {
+  Database(pool: String, backend_pid: Int, read_only: Bool, in_recovery: Bool)
+}
+
+pub type RollbackProof {
+  RollbackProof(inserted: Int, repaired: Int, temporary_table_absent: Bool)
+}
+
+pub type Error {
+  PoolUnavailable
+  DatabaseUnavailable
+}
+
+type Observation {
+  Observed(Database)
+  ObservationFailed
+}
+
+type ProbeResult {
+  Validated(RollbackProof)
+  Failed
+}
+
+@external(erlang, "dash_inspection_ffi", "overview")
+pub fn overview() -> Overview
+
+@external(erlang, "dash_inspection_ffi", "registered_names")
+pub fn registered_names() -> List(String)
+
+@external(erlang, "dash_inspection_ffi", "processes")
+fn process_snapshot(limit: Int) -> List(Process)
+
+/// At most 50 processes from a 2000-process sample, ordered by memory.
+/// Stack entries contain at most eight MFAs, without arguments or state.
+pub fn processes(limit: Int) -> List(Process) {
+  process_snapshot(case limit {
+    n if n > 0 && n <= 50 -> n
+    _ -> 10
+  })
+}
+
+@external(erlang, "dash_inspection_ffi", "ets")
+pub fn ets() -> List(Table)
+
+@external(erlang, "dash_inspection_ffi", "existing_name")
+fn existing_name(name: String) -> Result(process.Name(pog.Message), Nil)
+
+/// Exactly one existing authentication pool is required; never starts a pool.
+fn pool() -> Result(#(String, pog.Connection), Error) {
+  case
+    registered_names() |> list.filter(string.starts_with(_, "dash_auth_pool$"))
+  {
+    [name] -> {
+      use registered <- result.try(
+        existing_name(name) |> result.replace_error(PoolUnavailable),
+      )
+      Ok(#(name, pog.named_connection(registered)))
+    }
+    _ -> Error(PoolUnavailable)
+  }
+}
+
+/// The first statement selects READ ONLY. Settings and observation use the
+/// checked-out transaction connection, never the parent pool.
+pub fn database() -> Result(Database, Error) {
+  use #(name, db) <- result.try(pool())
+  exception.rescue(fn() {
+    let observation =
+      pog.transaction(db, fn(tx) {
+        use _ <- result.try(
+          sql.read_only(tx) |> result.replace_error(ObservationFailed),
+        )
+        use _ <- result.try(
+          sql.limits(tx) |> result.replace_error(ObservationFailed),
+        )
+        use rows <- result.try(
+          sql.snapshot(tx) |> result.replace_error(ObservationFailed),
+        )
+        case rows.rows {
+          [sql.SnapshotRow(pid, "on", recovery)] ->
+            Error(Observed(Database(name, pid, True, recovery)))
+          _ -> Error(ObservationFailed)
+        }
+      })
+    case observation {
+      Error(pog.TransactionRolledBack(Observed(value))) -> Ok(value)
+      _ -> Error(DatabaseUnavailable)
+    }
+  })
+  |> result.unwrap(Error(DatabaseUnavailable))
+}
+
+/// Deliberately mutates only a fresh transaction-local temporary table. No
+/// application row, recovery marker or migration is touched. ROLLBACK TO is
+/// verified on the same connection; callback Error then rolls back the outer
+/// transaction before pog checks the connection back in.
+pub fn rollback_probe() -> Result(RollbackProof, Error) {
+  use #(_, db) <- result.try(pool())
+  exception.rescue(fn() {
+    case pog.transaction(db, repair_temporary_data) {
+      Error(pog.TransactionRolledBack(Validated(proof))) -> Ok(proof)
+      _ -> Error(DatabaseUnavailable)
+    }
+  })
+  |> result.unwrap(Error(DatabaseUnavailable))
+}
+
+fn repair_temporary_data(tx: pog.Connection) -> Result(Nil, ProbeResult) {
+  use _ <- result.try(sql.limits(tx) |> result.replace_error(Failed))
+  use before <- result.try(sql.probe_absent(tx) |> result.replace_error(Failed))
+  use _ <- result.try(case before.rows {
+    [sql.ProbeAbsentRow(True)] -> Ok(Nil)
+    _ -> Error(Failed)
+  })
+  use _ <- result.try(sql.savepoint(tx) |> result.replace_error(Failed))
+  use _ <- result.try(sql.create_probe(tx) |> result.replace_error(Failed))
+  let key = "disposable-inspection-row"
+  use inserted <- result.try(
+    sql.insert_probe(tx, key) |> result.replace_error(Failed),
+  )
+  use _ <- result.try(case inserted {
+    pog.Returned(1, [sql.InsertProbeRow(k, "before")]) if k == key -> Ok(Nil)
+    _ -> Error(Failed)
+  })
+  use repaired <- result.try(
+    sql.repair_probe(tx, key) |> result.replace_error(Failed),
+  )
+  use _ <- result.try(case repaired {
+    pog.Returned(1, [sql.RepairProbeRow(k, "after")]) if k == key -> Ok(Nil)
+    _ -> Error(Failed)
+  })
+  use _ <- result.try(sql.rollback_probe(tx) |> result.replace_error(Failed))
+  use after <- result.try(sql.probe_absent(tx) |> result.replace_error(Failed))
+  case after.rows {
+    [sql.ProbeAbsentRow(True)] -> Error(Validated(RollbackProof(1, 1, True)))
+    _ -> Error(Failed)
+  }
+}
+
+/// A content-free trace target used to verify the tracing path.
+pub fn heartbeat() -> Nil {
+  Nil
+}
+
+pub type Resource {
+  Resource(pid: String, memory: Int)
+}
+
+pub type TraceError {
+  InvalidBounds
+  ExistingTrace
+  TraceUnavailable
+}
+
+pub type Trace {
+  Trace(events: Int, cleaned: Bool)
+}
+
+@external(erlang, "dash_inspection_ffi", "resources")
+pub fn resources() -> Result(List(Resource), Nil)
+
+@external(erlang, "dash_inspection_ffi", "trace")
+fn bounded_trace(
+  milliseconds: Int,
+  events: Int,
+  functions: List(#(String, String, Int)),
+) -> Result(Trace, TraceError)
+
+/// Traces only heartbeat/0 and health.ready/4, with arities and no return values.
+/// A target-side owner enforces both bounds even after RPC disconnection.
+pub fn trace(milliseconds: Int, events: Int) -> Result(Trace, TraceError) {
+  case
+    milliseconds >= 10 && milliseconds <= 2000 && events > 0 && events <= 20
+  {
+    True ->
+      bounded_trace(milliseconds, events, [
+        #("dash_abertura_backend@inspection", "heartbeat", 0),
+        #("dash_abertura_backend@health", "ready", 4),
+      ])
+    False -> Error(InvalidBounds)
+  }
+}
+
+pub type Child {
+  Child(pid: String, kind: String, modules: List(String))
+}
+
+/// Immediate supervisor children, without child identifiers or state. A local
+/// registered name or a target-generated PID from processes/1 is required.
+/// Client-rendered remote PIDs must not be copied back; their node number differs.
+/// Dead/non-supervisor PIDs fail within 200ms.
+@external(erlang, "dash_inspection_ffi", "children")
+pub fn children(name_or_pid: String) -> Result(List(Child), Nil)
