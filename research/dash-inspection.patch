diff --git a/backend/api/src/dash_inspection_ffi.erl b/backend/api/src/dash_inspection_ffi.erl
new file mode 100644
index 0000000..7b738b4
--- /dev/null
+++ b/backend/api/src/dash_inspection_ffi.erl
@@ -0,0 +1,155 @@
+-module(dash_inspection_ffi).
+-export([overview/0, registered_names/0, existing_name/1, processes/1, ets/0, resources/0, trace/3, children/1]).
+
+overview() ->
+    {overview, atom_to_binary(node()), erlang:system_info(process_count),
+     erlang:memory(total), erlang:system_info(schedulers_online)}.
+
+registered_names() -> lists:sublist(lists:sort([atom_to_binary(N) || N <- registered()]), 2000).
+
+%% Never creates an atom from operator input or coerces an arbitrary handle.
+existing_name(Name) ->
+    try binary_to_existing_atom(Name) of
+        Atom -> case whereis(Atom) of undefined -> {error, nil}; _ -> {ok, Atom} end
+    catch error:badarg -> {error, nil} end.
+
+processes(Limit) ->
+    Values = [{proplists:get_value(memory, Info, 0), P, Info}
+              || P <- lists:sublist(erlang:processes(), 2000),
+                 Info <- [process_info(P, [registered_name, memory, message_queue_len, status, reductions])],
+                 Info =/= undefined],
+    [snapshot(P, Info) || {_, P, Info} <- lists:sublist(lists:reverse(lists:sort(Values)), Limit)].
+
+snapshot(Pid, Info) ->
+    Name = case proplists:get_value(registered_name, Info, []) of
+        [] -> <<>>; N -> atom_to_binary(N) end,
+    Frames = case process_info(Pid, current_stacktrace) of
+        {current_stacktrace, S} -> S; undefined -> [] end,
+    Stack = [iolist_to_binary(io_lib:format("~s:~s/~B", [M, F, A]))
+             || {M, F, A, _} <- lists:sublist(Frames, 8),
+                is_integer(A)],
+    {process, list_to_binary(pid_to_list(Pid)), Name,
+     proplists:get_value(memory, Info, 0),
+     proplists:get_value(message_queue_len, Info, 0),
+     atom_to_binary(proplists:get_value(status, Info, waiting)),
+     proplists:get_value(reductions, Info, 0), Stack}.
+
+ets() ->
+    lists:sublist(lists:filtermap(fun(T) ->
+        try {true, {table, atom_to_binary(ets:info(T, name)),
+                    ets:info(T, size), ets:info(T, memory),
+                    list_to_binary(pid_to_list(ets:info(T, owner))),
+                    atom_to_binary(ets:info(T, protection)),
+                    atom_to_binary(ets:info(T, type))}}
+        catch error:badarg -> false end
+    end, lists:sublist(ets:all(), 50)), 50).
+
+%% Recon's auxiliary process data is deliberately discarded.
+resources() ->
+    try {ok, [{resource, list_to_binary(pid_to_list(P)), Bytes}
+              || {P, Bytes, _} <- recon:proc_count(memory, 5)]}
+    catch _:_ -> {error, nil} end.
+
+trace(Milliseconds, Limit, Functions) ->
+    Caller = self(), Ref = make_ref(),
+    Owner = spawn(fun() -> trace_owner(Caller, Ref, Milliseconds, Limit, Functions) end),
+    Monitor = erlang:monitor(process, Owner),
+    receive
+        {Ref, Result} -> erlang:demonitor(Monitor, [flush]), Result;
+        {'DOWN', Monitor, process, Owner, _} -> {error, trace_unavailable}
+    after Milliseconds + 1000 ->
+        erlang:demonitor(Monitor, [flush]), {error, trace_unavailable}
+    end.
+
+trace_owner(Caller, Ref, Milliseconds, Limit, Functions) ->
+    case catch register(dash_inspection_trace_owner, self()) of
+        true ->
+            try
+                case existing_trace() of
+                    true -> Caller ! {Ref, {error, existing_trace}};
+                    false -> run_trace(Caller, Ref, Milliseconds, Limit, Functions)
+                end
+            catch _:_ -> Caller ! {Ref, {error, trace_unavailable}}
+            after unregister(dash_inspection_trace_owner) end;
+        _ -> Caller ! {Ref, {error, existing_trace}}
+    end.
+
+existing_trace() ->
+    whereis(recon_trace_tracer) =/= undefined orelse
+    whereis(recon_trace_formatter) =/= undefined orelse
+    lists:any(fun(P) ->
+        case erlang:trace_info(P, flags) of {flags, []} -> false; undefined -> false; _ -> true end
+    end, erlang:processes()) orelse
+    lists:any(fun({M, _}) ->
+        lists:any(fun({F,A}) ->
+            case erlang:trace_info({M,F,A}, all) of
+                {all, Properties} when is_list(Properties) -> lists:any(fun
+                    ({traced, false}) -> false;
+                    ({traced, _}) -> true;
+                    ({meta, false}) -> false;
+                    ({meta, _}) -> true;
+                    ({call_count, false}) -> false;
+                    ({call_count, _}) -> true;
+                    ({call_time, false}) -> false;
+                    ({call_time, _}) -> true;
+                    (_) -> false
+                end, Properties);
+                {all, false} -> false;
+                undefined -> false
+            end
+        end, M:module_info(functions))
+    end, code:all_loaded()).
+
+run_trace(Caller, Ref, Milliseconds, Limit, Functions) ->
+    %% Recon can emit its own limit message; a private I/O sink keeps all trace
+    %% output out of application stdout. Only an aggregate count is returned.
+    Owner = self(), Sink = spawn(fun io_sink/0),
+    group_leader(Sink, self()), process_flag(trap_exit, true),
+    try
+        Patterns = [{binary_to_existing_atom(M), binary_to_existing_atom(F), A}
+                    || {M, F, A} <- Functions],
+        recon_trace:calls(Patterns, Limit,
+                          [{args, arity}, {formatter, fun(_) -> Owner ! trace_event, "" end},
+                           {io_server, Sink}]),
+        _ = 'dash_abertura_backend@inspection':heartbeat(),
+        Deadline = erlang:monotonic_time(millisecond) + Milliseconds,
+        Count = trace_count(Deadline, 0),
+        recon_trace:clear(),
+        Caller ! {Ref, {ok, {trace, Count, not existing_trace()}}}
+    catch _:_ ->
+        recon_trace:clear(), Caller ! {Ref, {error, trace_unavailable}}
+    after exit(Sink, kill) end.
+
+trace_count(Deadline, Count) ->
+    Remaining = max(0, Deadline - erlang:monotonic_time(millisecond)),
+    receive trace_event -> trace_count(Deadline, Count + 1)
+    after Remaining -> Count end.
+
+io_sink() ->
+    receive
+        {io_request, From, ReplyAs, _} ->
+            From ! {io_reply, ReplyAs, ok}, io_sink();
+        _ -> io_sink()
+    end.
+
+
+children(Text) ->
+    try resolve_pid(Text) of
+        Pid when node(Pid) =:= node() ->
+            try gen_server:call(Pid, which_children, 200) of
+                Children when is_list(Children) ->
+                    {ok, [{child, list_to_binary(pid_to_list(P)), atom_to_binary(Kind),
+                           [atom_to_binary(M) || M <- Modules]}
+                          || {_, P, Kind, Modules} <- lists:sublist(Children, 50),
+                             is_pid(P), is_list(Modules)]};
+                _ -> {error, nil}
+            catch _:_ -> {error, nil} end;
+        _ -> {error, nil}
+    catch _:_ -> {error, nil} end.
+
+%% Resolve on the target: external PIDs printed in a client VM have a different
+%% node-number component and must not be converted back from client display.
+resolve_pid(<<"<", _/binary>> = Text) -> list_to_pid(binary_to_list(Text));
+resolve_pid(Name) ->
+    Atom = binary_to_existing_atom(Name),
+    case whereis(Atom) of undefined -> error(not_found); Pid -> Pid end.
